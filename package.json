{
  "name": "infinite-house-radio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/worker.ts",
    "stream": "tsx src/stream.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "generate": "tsx src/generate-standalone.ts",
    "start": "node dist/src/server.js",
    "test": "vitest run --root . src",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.1.1",
    "@prisma/client": "^6.7.0",
    "bullmq": "^5.52.2",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.2",
    "ioredis": "^5.6.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "@vitejs/plugin-react": "^4.4.1",
    "prisma": "^6.7.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  }
}
